// Start locked so keystrokes pass straight through to whatever is
// nested inside (tmux/screen/vim/etc). Press Ctrl+g to unlock when
// you actually want to drive zellij itself.
default_mode "locked"

// No tab-bar / status-bar chrome, no first-run wizard or release notes popup.
default_layout "default"
show_startup_tips false
show_release_notes false

// Match tmux's default-shell so panes get fish (and its fish_title override
// below) instead of falling back to $SHELL, which may be bash.
default_shell "/usr/bin/fish"

// Use xsel directly instead of relying on OSC52 passthrough, which doesn't
// always reach the X11 clipboard reliably through nested terminals/muxers.
copy_command "xsel --clipboard --input"

// We only ever use single-pane sessions, so there's no layout worth
// resurrecting after a crash/reboot - without this, dead sessions linger
// forever in `zellij list-sessions` as "EXITED - attach to resurrect".
session_serialization false
